<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Shredzilla" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- No bar colors here: the app is edge-to-edge (enableEdgeToEdge) and draws behind transparent
             system bars; Android 15+ ignores android:statusBarColor anyway. -->
    </style>

    <!-- Splash: edge-to-edge like the rest of the app, no title -->
    <style name="Theme.Shredzilla.NoActionBar" parent="Theme.Shredzilla">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>
