<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for Android 11 and older (Android 12+ uses data_extraction_rules.xml).
   Firebase Auth encrypts the saved sign-in with a key kept in the Android Keystore, which is never
   backed up. Restoring its files onto a new install leaves a key that can't be used, and the app
   then can't keep anyone signed in, so they are excluded. Signing in again after a restore is
   expected; training data lives in the account.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="com.google.firebase.auth.api.crypto.W0RFRkFVTFRd+MTo1MDE0ODU1MzU4MzY6YW5kcm9pZDoxZjVhNDk4MjIwNGI0YjY1Mjc5Yzk5.xml" />
    <exclude domain="sharedpref" path="com.google.firebase.auth.api.Store.W0RFRkFVTFRd+MTo1MDE0ODU1MzU4MzY6YW5kcm9pZDoxZjVhNDk4MjIwNGI0YjY1Mjc5Yzk5.xml" />
    <exclude domain="sharedpref" path="session.xml" />
    <exclude domain="sharedpref" path="workout_session.xml" />
</full-backup-content>
