<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup and device-transfer rules for Android 12+. Firebase Auth's saved sign-in is encrypted with
   a Keystore key that never leaves the device, so its files are excluded: restored without the key
   they'd stop the app from keeping anyone signed in. See backup_rules.xml for older versions.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="com.google.firebase.auth.api.crypto.W0RFRkFVTFRd+MTo1MDE0ODU1MzU4MzY6YW5kcm9pZDoxZjVhNDk4MjIwNGI0YjY1Mjc5Yzk5.xml" />
        <exclude domain="sharedpref" path="com.google.firebase.auth.api.Store.W0RFRkFVTFRd+MTo1MDE0ODU1MzU4MzY6YW5kcm9pZDoxZjVhNDk4MjIwNGI0YjY1Mjc5Yzk5.xml" />
        <exclude domain="sharedpref" path="session.xml" />
        <exclude domain="sharedpref" path="workout_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="com.google.firebase.auth.api.crypto.W0RFRkFVTFRd+MTo1MDE0ODU1MzU4MzY6YW5kcm9pZDoxZjVhNDk4MjIwNGI0YjY1Mjc5Yzk5.xml" />
        <exclude domain="sharedpref" path="com.google.firebase.auth.api.Store.W0RFRkFVTFRd+MTo1MDE0ODU1MzU4MzY6YW5kcm9pZDoxZjVhNDk4MjIwNGI0YjY1Mjc5Yzk5.xml" />
        <exclude domain="sharedpref" path="session.xml" />
        <exclude domain="sharedpref" path="workout_session.xml" />
    </device-transfer>
</data-extraction-rules>
