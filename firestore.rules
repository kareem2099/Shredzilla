rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Everything a user owns: profile, exercise library and lists, logged sets,
    // workouts, records and body measurements. Nothing else is readable or writable.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
